{
  "version": 1,
  "roles": [
    {
      "id": "extract-runner",
      "label": "Курьер Extract",
      "description": "Забирает жетоны Extract, сохраняет их и приносит очки.",
      "icon": "person-running"
    },
    {
      "id": "extract-hunter",
      "label": "Охотник за носителями",
      "description": "Отбирает Extract или заставляет носителя уронить жетон.",
      "icon": "crosshairs"
    },
    {
      "id": "secure-holder",
      "label": "Держатель Secure",
      "description": "Удерживает точку за счёт живучести, позиции или угрозы противнику.",
      "icon": "flag"
    },
    {
      "id": "secure-flipper",
      "label": "Специалист по переключению точек",
      "description": "Быстро меняет точки или надёжно взаимодействует с Secure.",
      "icon": "arrows-rotate"
    },
    {
      "id": "brawler",
      "label": "Боец",
      "description": "Ведёт затяжную драку в нужной зоне, сочетая урон и живучесть.",
      "icon": "hand-fist"
    },
    {
      "id": "striker",
      "label": "Ударник",
      "description": "Создаёт угрозу быстрого большого урона ключевой цели.",
      "icon": "bolt"
    },
    {
      "id": "shooter",
      "label": "Стрелок",
      "description": "Давит атаками с дистанции и помогает добивать цели.",
      "icon": "bullseye"
    },
    {
      "id": "controller",
      "label": "Контроллер",
      "description": "Сдвигает противника, накладывает состояния и ограничивает его действия.",
      "icon": "magnet"
    },
    {
      "id": "support",
      "label": "Поддержка",
      "description": "Помогает союзникам энергией, перемещением, лечением или перебросами.",
      "icon": "hand-holding-heart"
    },
    {
      "id": "protector",
      "label": "Защитник",
      "description": "Сохраняет ключевых союзников и мешает удобному выбору цели.",
      "icon": "shield-halved"
    }
  ],
